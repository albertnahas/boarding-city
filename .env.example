# Required for `python -m boarding_city build`
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
BOARDING_FAST_MODEL=gpt-6-luna
BOARDING_TRACE_MODEL=gpt-6.1-terra
BOARDING_TRACE_EFFORT=low
# Seconds per API call, and attempts per call
BOARDING_TIMEOUT=180
BOARDING_RETRIES=3

# Web builder (Vercel) only
BLOB_READ_WRITE_TOKEN=
BC_MAX_FILES=1500
BC_BUILDS_PER_HOUR=3
BC_ESTIMATES_PER_HOUR=20
BC_DAILY_CAP_USD=5
BC_SALT=
